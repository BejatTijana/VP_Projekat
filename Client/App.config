<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<system.serviceModel>
		<client>
			<endpoint name="WeatherService"
					  address="net.tcp://localhost:4007/WeatherService"
					  binding="netTcpBinding"
					  bindingConfiguration="WeatherBinding"
					  contract="Common.IWeatherService" />
		</client>

		<bindings>
			<netTcpBinding>
				<binding name="WeatherBinding"
						 maxReceivedMessageSize="10485760"
						 transferMode="Streamed"
						 receiveTimeout="00:10:00"
						 sendTimeout="00:10:00">
					<security mode="None"/>
				</binding>
			</netTcpBinding>
		</bindings>

	</system.serviceModel>

	<appSettings>
		<add key="csvPath" value="C:\Users\tijana\OneDrive\Desktop\VP_Projekat\meteorologija.csv"/>
		<add key="maxRows" value="107"/>
	</appSettings>

</configuration>