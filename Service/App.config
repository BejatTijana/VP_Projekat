<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="P_threshold" value="5.0"/>
    <add key="VPact_threshold" value="1.5"/>
    <add key="VPdef_threshold" value="1.5"/>
  </appSettings>
  <system.serviceModel>
    <services>
      <service name="Service.WeatherService">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8090"/>
          </baseAddresses>
        </host>
        <endpoint address="WeatherService"
                  binding="netTcpBinding"
                  contract="Common.IWeatherService"/>
      </service>
    </services>
  </system.serviceModel>
</configuration>