<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<system.serviceModel>
		<services>
			<service name="Service.WeatherService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:4007" />
					</baseAddresses>
				</host>
				<endpoint
				  address="WeatherService"
				  binding="netTcpBinding"
				  bindingConfiguration="WeatherBinding"
				  contract="Common.IWeatherService" />
			</service>
		</services>

		<bindings>
			<netTcpBinding>
				<binding name="WeatherBinding"
						 maxReceivedMessageSize="10485760"
						 transferMode="Streamed"
						 receiveTimeout="00:10:00"
						 sendTimeout="00:10:00">
					<security mode="None"/>
				</binding>
			</netTcpBinding>
		</bindings>

	</system.serviceModel>

	<appSettings>
		<add key="path" value="Measurements"/>
		<add key="P_threshold" value="0.15"/>
		<add key="VPact_threshold" value="0.10"/>
		<add key="VPdef_threshold" value="0.10"/>
	</appSettings>

</configuration>